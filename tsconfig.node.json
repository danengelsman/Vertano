{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "outDir": "dist-server",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": false,
    "types": ["node"]
  },
  "include": ["server.ts", "src/db.ts", "src/firebase.ts"],
  "exclude": ["node_modules", "dist", "dist-server", "src/**/*.tsx", "src/**/*.app.ts", "src/**/*.app.tsx"]
}