{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": false,
    "outDir": "dist-server",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": false,
    "types": ["node"]
  },
  "include": ["server.ts", "src/db.ts", "src/firebase.ts", "src/vite-env.d.ts"],
  "exclude": ["node_modules", "dist", "dist-server", "src/**/*.tsx", "src/**/*.app.ts", "src/**/*.app.tsx"]
}