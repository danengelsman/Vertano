@import "tailwindcss";

@plugin "@tailwindcss/typography";

/* ---------- Theme tokens ---------- */
@theme {
  --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
  --font-mono: ui-monospace, SFMono-Regular, Menlo, monospace;

  --color-bg: #0b0b0f;
  --color-surface: #15151c;
  --color-border: #2a2a35;
  --color-text: #ececf1;
  --color-muted: #9a9aa6;
  --color-accent: #6366f1;
}

/* ---------- Base ---------- */
@layer base {
  html {
    -webkit-text-size-adjust: 100%;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    @apply bg-[var(--color-bg)] text-[var(--color-text)] font-sans antialiased;
    min-height: 100dvh;
  }

  a {
    @apply text-[var(--color-accent)] hover:underline underline-offset-2;
  }

  *:focus-visible {
    @apply outline-2 outline-offset-2 outline-[var(--color-accent)];
  }

  ::selection {
    background: color-mix(in oklab, var(--color-accent) 40%, transparent);
  }
}

/* ---------- Components ----------
   Important (Tailwind v4): @apply only accepts real utilities,
   not other custom classes. Compose in HTML: class="btn btn-primary"
*/
@layer components {
  .container-app {
    @apply mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8;
  }

  .btn {
    @apply inline-flex items-center justify-center rounded-md px-4 py-2
           text-sm font-medium transition
           focus-visible:outline-2 focus-visible:outline-offset-2
           disabled:opacity-50 disabled:pointer-events-none;
  }

  .btn-primary {
    @apply bg-[var(--color-accent)] text-white hover:opacity-90;
  }

  .btn-ghost {
    @apply border border-[var(--color-border)] hover:bg-[var(--color-surface)];
  }

  .card {
    @apply rounded-xl border border-[var(--color-border)]
           bg-[var(--color-surface)] p-6 shadow-sm;
  }
}

/* ---------- Utilities ---------- */
@layer utilities {
  .text-muted {
    color: var(--color-muted);
  }

  .scrollbar-thin {
    scrollbar-width: thin;
  }
}
