# Client-side (Vite exposes VITE_-prefixed vars to the browser).
# These are the Supabase project's public URL and publishable/anon key —
# safe to expose because row-level security protects every table.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side secrets live in Supabase Edge Function secrets, NOT here:
#   supabase secrets set GEMINI_API_KEY=your-key
# (used by the generate-content and score-content functions)
