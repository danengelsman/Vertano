# ─── Required to run the app ────────────────────────────────────────────────

# Gemini API — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth — get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# App URL (use http://localhost:3000 for local dev)
APP_URL=http://localhost:3000

# Session signing secret — used to HMAC-sign the login session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Falls back to an insecure dev default if unset; ALWAYS set a real value in production.
SESSION_SECRET=your_long_random_session_secret_here

# ─── Optional (Supabase, for future auth/DB migration) ──────────────────────
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here